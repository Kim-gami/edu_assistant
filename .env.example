# ── 앱 설정 ─────────────────────────────────────────────────────────────────
APP_ENV=development          # development | production
LOG_LEVEL=INFO

# ── PostgreSQL ───────────────────────────────────────────────────────────────
DB_HOST=localhost             # Phase 1: 앱이 Windows 직접 실행이므로 localhost. Docker 컨테이너 실행 시 db로 변경
DB_PORT=5432
DB_NAME=lecture_quiz
DB_USER=quiz_user
DB_PASSWORD=changeme         # 운영 환경에서는 반드시 강한 패스워드로 변경

# DATABASE_URL은 config.py에서 위 값들로 자동 조합됨
# asyncpg 드라이버 사용: postgresql+asyncpg://user:pass@host:port/db

# ── 파일 업로드 ───────────────────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=200

# ── LLM (Phase 1 — 미확정, 나중에 채울 것) ──────────────────────────────────
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# ── Redis (Phase 2 — Celery 전환 시 주석 해제) ──────────────────────────────
# REDIS_URL=redis://redis:6379/0
